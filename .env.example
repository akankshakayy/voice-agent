# --- AI engine -------------------------------------------------------------
# Leave every key empty to run on the free offline rules engine.
#
# FREE: Groq. Get a key at https://console.groq.com/keys (no card needed).
# The same key also powers speech-to-text, so the mic works in any browser.
GROQ_API_KEY=
# Comma-separated: when one model hits its free rate limit, the next one answers
GROQ_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
#
# FREE alternative: Google Gemini. Key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
#
# PAID: Anthropic Claude. Key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
#
# auto = first provider with a key (groq, then gemini, then claude) | groq | gemini | claude
LLM_PROVIDER=auto
# auto = use the LLM if a key is present, else rules | rules = always rules
AGENT_ENGINE=auto

# --- Voice -----------------------------------------------------------------
# Agent voice (free Microsoft Edge neural voices, no key needed)
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_VOICE_EN=en-IN-NeerjaNeural
# Speech-to-text model on Groq (used when GROQ_API_KEY is set)
STT_MODEL=whisper-large-v3-turbo

# --- Dashboard cost estimate (Claude only; Groq/Gemini free tiers count as 0)
LLM_PRICE_INPUT_PER_M=1.0
LLM_PRICE_OUTPUT_PER_M=5.0
USD_INR=84

# --- Login ------------------------------------------------------------------
# Over HTTPS the session cookie is only sent securely anyway; 1 forces that on every address
COOKIE_SECURE=0
# Only these email domains can sign up (comma-separated; * = any)
ALLOWED_EMAIL_DOMAINS=eko.co.in,ekosupport.in
# These people are admins (comma-separated). Unset: the very first account becomes admin. Set it on any server.
ADMIN_EMAILS=
# Role for new accounts that aren't an RM on the calling sheet: ops, or pending to make admins hand out access
DEFAULT_ROLE=ops
# Sign in with Google (OAuth client, type Web application; redirect URI <APP_BASE_URL>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local testing only: password signups work without email, unconfirmed. Never set this on a server.
ALLOW_UNVERIFIED_SIGNUP=0
# Signed out after this many hours without using the app (logins last 7 days at most)
SESSION_IDLE_HOURS=12
# 1 behind nginx: record the client's address from X-Forwarded-For in the sign-in activity
TRUST_PROXY=0
# Public address of the app, used in emailed links and Google sign-in, e.g. https://indev.eko.in/rm-voice-agent.
# Its path (/rm-voice-agent) is also the login cookie's path (or set COOKIE_PATH)
APP_BASE_URL=
# Email for password reset and email confirmation links. Leave SMTP_HOST empty to turn email off
# (an admin can then make reset links on the Users page).
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Data
# 1 = start with made-up RMs/CSPs (only on a database without real data, e.g. EKO_DB_PATH=data/demo.db)
DEMO_DATA=0
# Calls involving real CSPs (from Eko's sheets) are refused until this is 1. Keep it 0 until Sahayak is deployed
# on a phone line; test with the made-up CSPs from `python -m app.synthetic` instead.
REAL_CSP_CALLS=0

# --- Calls
# Calls with no activity for this many minutes are closed automatically (same as a hang-up)
CALL_IDLE_TIMEOUT_MIN=10

# --- Call recordings pilot (app/recordings.py, uploader/)
# Phones upload each recording a few minutes after the call, and it is processed straight away.
# To process them once a day instead, set a time, e.g. RECORDINGS_DAILY_AT=21:00
RECORDINGS_DAILY_AT=
RECORDINGS_TZ=Asia/Kolkata
# Whisper language for whole calls: hi (Hindi/Hinglish), en, or auto
RECORDINGS_LANG=hi
# Whisper model for recorded calls (the live agent uses STT_MODEL, the faster turbo one)
RECORDINGS_STT_MODEL=whisper-large-v3
# Speakers in recordings are told apart by voice with two small local models (sherpa-onnx). Fetch them once with
#   python -m app.diarize download
# 0 = find out how many people speak; set 2 to force exactly two
RECORDINGS_SPEAKERS=0
RECORDINGS_SPEAKER_THRESHOLD=0.5

# Sarvam AI (sarvam.ai): with a key, recorded calls are transcribed and split by speaker by Sarvam, which is built for
# Hindi and Hinglish (servers in India). Without one they use Groq Whisper + the local voice model.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix
