# AutoGMap Integration (Phase 7a: Numbers Sync)
AUTOGMAP_ENABLED=true
AUTOGMAP_NUMBERS_URL=https://indev.eko.in/autogmap/api/v1/call-recorder/numbers
AUTOGMAP_RECORDINGS_URL=https://indev.eko.in/autogmap/api/v1/call-recorder/recordings
# AUTOGMAP_API_KEY: Request from Mansi team (see docs/PHASE7_ACTION_PLAN.md) - set in .env.local
AUTOGMAP_SYNC_INTERVAL_MINUTES=15
AUTOGMAP_SYNC_TIMEOUT_SECONDS=30

# AutoGMap Integration (Phase 7b: Recording Upload)
AUTOGMAP_UPLOAD_RETRY_MAX=3
AUTOGMAP_UPLOAD_RETRY_BACKOFF=60,300,900
AUTOGMAP_UPLOAD_TIMEOUT_SECONDS=60

# Prachi Integration (DC Mode - Webhook)
# Prachi CRM receives DC verification call recordings in real-time via webhook
PRACHI_WEBHOOK_URL=https://indev.eko.in/sbi-relationship-crm/api/v1/webhooks/recordings
# PRACHI_RECORDING_SECRET: Shared secret for X-Recording-Secret header (request from Prachi team, set in .env.local)
PRACHI_WEBHOOK_ENABLED=true                          # Enable/disable real-time webhook push
PRACHI_WEBHOOK_TIMEOUT_SECONDS=30                    # Webhook request timeout
PRACHI_WEBHOOK_RETRY_MAX=3                          # Max retries on failure
PRACHI_WEBHOOK_RETRY_BACKOFF=300,3600,86400         # Retry intervals (5min, 1hr, 24hr)
# Note: Only DC recordings with consent are sent to Prachi
# Payload: id, dc_number, other_number, direction, started_at, duration, audio_url
# Max batch size: 50 recordings per request

# Prachi Google Sheets Daily Sync (app/prachi_sync.py)
# Sheet: https://docs.google.com/spreadsheets/d/1lz7RihRysA10akqcwrxrRUq2fVYw4Mr-w7DclVRApLw/edit?usp=sharing
# Public access (anyone can view)
PRACHI_SHEET_ID=1lz7RihRysA10akqcwrxrRUq2fVYw4Mr-w7DclVRApLw
PRACHI_SYNC_ENABLED=true
PRACHI_SYNC_SCHEDULE_HOUR=2           # Hour of day to run sync (0-23, default: 2 AM UTC)
PRACHI_SYNC_TIMEOUT_SECONDS=60        # Request timeout for fetching sheets
PRACHI_SYNC_RETRY_MAX=3               # Max retries on transient failures
# Sync source hierarchy (Phase 7d Refactor: API Primary, Excel Secondary)
# PRIMARY: Google Sheets API (automatic, always runs daily)
# SECONDARY: Manual Excel override (temporary, will be overwritten by next API sync)
